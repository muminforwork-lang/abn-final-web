{
  "name": "abnormal-store",
  "version": "1.0.0",
  "private": true,
  "description": "ABNORMAL — public product catalogue for PC, Android and iOS with manual payment instructions and no customer accounts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/static-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "next build && node --import ./tests/lib/aliases.mjs --test \"tests/*.test.ts\"",
    "test:only": "node --import ./tests/lib/aliases.mjs --test \"tests/*.test.ts\"",
    "check": "node scripts/browser-check.mjs",
    "check:mobile": "node scripts/mobile-check.mjs",
    "add-product": "node scripts/add-product.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
